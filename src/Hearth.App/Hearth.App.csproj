<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hearth.App</RootNamespace>
    <AssemblyName>Hearth</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\Hearth.ico</ApplicationIcon>

    <!-- Self-contained trimming is off: we reflect over COM interfaces. -->
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearth.Core\Hearth.Core.csproj" />
  </ItemGroup>

</Project>
